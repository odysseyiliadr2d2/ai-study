<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>study</groupId>
  <artifactId>s10-advanced-rag</artifactId>
  <version>1.0.0</version>
  <description>세션 10 하이브리드 검색 · 리랭커 · 평가 (Java 트랙)</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <anthropic.version>3.8.0</anthropic.version>
    <jackson.version>2.23.0</jackson.version>
    <langchain4j-beta.version>1.23.0-beta33</langchain4j-beta.version>
    <lucene.version>10.6.0</lucene.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic.version}</version>
    </dependency>
    <dependency>   <!-- 2.x 최신은 Maven Central 에서 확인 -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>   <!-- 세션 9 와 같은 임베딩 모듈 -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-embeddings</artifactId>
      <version>${langchain4j-beta.version}</version>
    </dependency>
    <dependency>   <!-- cross-encoder 리랭커 (ONNX) -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-onnx-scoring</artifactId>
      <version>${langchain4j-beta.version}</version>
    </dependency>
    <dependency>   <!-- BM25Similarity -->
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>   <!-- 한국어 형태소 분석기 Nori -->
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-nori</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-queryparser</artifactId>
      <version>${lucene.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ./mvnw -q compile exec:java -Dexec.mainClass=... 로 실행 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <mainClass>study.s10.Guard</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
