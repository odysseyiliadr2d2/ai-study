// ~/.openclaw/openclaw.json 에 병합할 최소 권한 예시 (키 이름은 docs.openclaw.ai 의 최신 설정 문서로 확인)
{
  agents: {
    defaults: {
      sandbox: { mode: "all" },          // 모든 세션의 도구 실행을 샌드박스(Docker 등)로
    },
  },
  tools: {
    profile: "messaging",                // 메시지 위주 기본 프로필
    deny: ["group:runtime", "write", "edit", "apply_patch", "browser"],   // 셸 실행·파일 수정·브라우저 금지
  },
}
